{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.json" }]
  },
  "setupFiles": ["<rootDir>/test/setup-env.js"],
  "globalSetup": "<rootDir>/test/global-setup.js",
  "testTimeout": 30000
}
