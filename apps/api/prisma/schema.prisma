generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(uuid()) @db.Uuid
  destination String    @unique
  displayName String    @map("display_name")
  city        String?
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  devices     Device[]
  sessions    Session[]
  memberships PartnershipMember[]
  invites     PairInvite[]
  notes       Note[]
  events      Event[]
  messages    Message[]
  receipts    MessageReceipt[]
  secrets     SecretMessage[]
  media       MediaObject[]
  stories     StoryEntry[]

  @@map("users")
}

model Device {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  platform   String
  pushToken  String?  @map("push_token")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]
  pushes   PushDelivery[]

  @@map("devices")
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  deviceId    String    @map("device_id") @db.Uuid
  refreshHash String    @unique @map("refresh_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Partnership {
  id        String    @id @default(uuid()) @db.Uuid
  startedOn DateTime  @map("started_on") @db.Date
  status    String
  closedAt  DateTime? @map("closed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  members PartnershipMember[]
  invites PairInvite[]
  notes   Note[]
  events  Event[]
  messages Message[]
  secrets  SecretMessage[]
  media    MediaObject[]
  albums   Album[]
  stories  StoryEntry[]
  lists    SharedList[]
  saved    SavedItem[]

  @@map("partnerships")
}

model PartnershipMember {
  id            String   @id @default(uuid()) @db.Uuid
  partnershipId String   @map("partnership_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  status        String
  createdAt     DateTime @default(now()) @map("created_at")

  partnership Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([partnershipId, userId])
  @@index([userId, status])
  @@map("partnership_members")
}

model PairInvite {
  id            String    @id @default(uuid()) @db.Uuid
  code          String    @unique
  creatorId     String    @map("creator_id") @db.Uuid
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")
  partnershipId String?   @map("partnership_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")

  creator     User         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  partnership Partnership? @relation(fields: [partnershipId], references: [id])

  @@map("pair_invites")
}

model Note {
  id            String   @id @default(uuid()) @db.Uuid
  partnershipId String   @map("partnership_id") @db.Uuid
  authorId      String   @map("author_id") @db.Uuid
  body          String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  partnership Partnership  @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  stories     StoryEntry[]

  @@index([partnershipId, createdAt])
  @@map("notes")
}

model Event {
  id                   String   @id @default(uuid()) @db.Uuid
  partnershipId        String   @map("partnership_id") @db.Uuid
  authorId             String   @map("author_id") @db.Uuid
  title                String
  startsAt             DateTime @map("starts_at")
  timezone             String
  kind                 String
  remindOffsetMinutes  Int?     @map("remind_offset_minutes")
  createdAt            DateTime @default(now()) @map("created_at")

  partnership Partnership    @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  author      User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  pushes      PushDelivery[]

  @@index([partnershipId, startsAt])
  @@map("events")
}

model PushDelivery {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String   @map("device_id") @db.Uuid
  eventId   String?  @map("event_id") @db.Uuid
  messageId String?  @map("message_id") @db.Uuid
  title     String
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  device  Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  event   Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([eventId, deviceId])
  @@unique([messageId, deviceId])
  @@map("push_deliveries")
}

model Message {
  id            String   @id @default(uuid()) @db.Uuid
  partnershipId String   @map("partnership_id") @db.Uuid
  senderId      String   @map("sender_id") @db.Uuid
  clientMsgId   String   @map("client_msg_id")
  kind          String
  body          String?
  stickerId     String?  @map("sticker_id")
  createdAt     DateTime @default(now()) @map("created_at")

  partnership Partnership      @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  sender      User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  receipts    MessageReceipt[]
  pushes      PushDelivery[]

  @@unique([partnershipId, clientMsgId])
  @@index([partnershipId, createdAt])
  @@map("messages")
}

model MessageReceipt {
  id          String    @id @default(uuid()) @db.Uuid
  messageId   String    @map("message_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  deliveredAt DateTime? @map("delivered_at")
  readAt      DateTime? @map("read_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("message_receipts")
}

model SecretMessage {
  id            String    @id @default(uuid()) @db.Uuid
  partnershipId String    @map("partnership_id") @db.Uuid
  senderId      String    @map("sender_id") @db.Uuid
  kind          String
  body          String?
  imageRef      String?   @map("image_ref")
  revealedAt    DateTime? @map("revealed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  partnership Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  sender      User        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([partnershipId, createdAt])
  @@map("secret_messages")
}

model MediaObject {
  id            String    @id @default(uuid()) @db.Uuid
  partnershipId String    @map("partnership_id") @db.Uuid
  ownerId       String    @map("owner_id") @db.Uuid
  contentType   String    @map("content_type")
  byteSize      Int?      @map("byte_size")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  partnership Partnership  @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items       AlbumItem[]
  stories     StoryEntry[]

  @@index([partnershipId, createdAt])
  @@map("media_objects")
}

model Album {
  id            String   @id @default(uuid()) @db.Uuid
  partnershipId String   @map("partnership_id") @db.Uuid
  title         String
  createdAt     DateTime @default(now()) @map("created_at")

  partnership Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  items       AlbumItem[]

  @@index([partnershipId, createdAt])
  @@map("albums")
}

model AlbumItem {
  id        String   @id @default(uuid()) @db.Uuid
  albumId   String   @map("album_id") @db.Uuid
  mediaId   String   @map("media_id") @db.Uuid
  caption   String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  album Album       @relation(fields: [albumId], references: [id], onDelete: Cascade)
  media MediaObject @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([albumId, createdAt])
  @@map("album_items")
}

model StoryEntry {
  id            String   @id @default(uuid()) @db.Uuid
  partnershipId String   @map("partnership_id") @db.Uuid
  authorId      String   @map("author_id") @db.Uuid
  position      Int
  noteId        String?  @map("note_id") @db.Uuid
  mediaId       String?  @map("media_id") @db.Uuid
  caption       String   @default("")
  createdAt     DateTime @default(now()) @map("created_at")

  partnership Partnership  @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  note        Note?        @relation(fields: [noteId], references: [id], onDelete: Cascade)
  media       MediaObject? @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([partnershipId, position])
  @@map("story_entries")
}

model SharedList {
  id            String   @id @default(uuid()) @db.Uuid
  partnershipId String   @map("partnership_id") @db.Uuid
  title         String
  createdAt     DateTime @default(now()) @map("created_at")

  partnership Partnership      @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  items       SharedListItem[]

  @@index([partnershipId, createdAt])
  @@map("shared_lists")
}

model SharedListItem {
  id        String   @id @default(uuid()) @db.Uuid
  listId    String   @map("list_id") @db.Uuid
  body      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  list SharedList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId, createdAt])
  @@map("shared_list_items")
}

model DiscoverPlace {
  id      String @id @default(uuid()) @db.Uuid
  city    String
  title   String
  summary String

  saved SavedItem[]

  @@index([city])
  @@map("discover_places")
}

model SavedItem {
  id            String   @id @default(uuid()) @db.Uuid
  partnershipId String   @map("partnership_id") @db.Uuid
  placeId       String   @map("place_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  partnership Partnership    @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  place       DiscoverPlace  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([partnershipId, placeId])
  @@map("saved_items")
}
